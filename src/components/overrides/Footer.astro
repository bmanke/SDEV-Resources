---
import Default from '@astrojs/starlight/components/Footer.astro';
import { Icon } from '@astrojs/starlight/components';

const repo = 'https://github.com/bmanke/SDEV-Resources';
---

<div class="contribute">
	<Icon name="github" size="1.5rem" />
	<p>
		Found a mistake or want to add something? This site is open source.<br/>
		<a href={`${repo}/issues/new`} target="_blank" rel="noopener">Open an issue</a>,
		<a href={`${repo}/pulls`} target="_blank" rel="noopener">send a pull request</a>, or
		<a href={repo} target="_blank" rel="noopener"> view the repository</a>.
	</p>
</div>

<Default {...Astro.props}><slot /></Default>

<style>
	.contribute {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 2rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
	}
	.contribute :global(svg) {
		flex-shrink: 0;
		color: var(--sl-color-accent);
	}
	p {
		margin: 0;
		font-size: var(--sl-text-sm);
	}
	a {
		color: var(--sl-color-accent-high);
		font-weight: 600;
	}
</style>
